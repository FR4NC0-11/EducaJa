{
  "name": "EducaJá",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/EducaJa",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "EducaJá",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 2
      }
    }
  },
  "postCreateCommand": "npm ci && npm run db:migrate"
}
