# Exemplo sem segredos. Configure os valores no painel da hospedagem.
# Para verificar a partir deste computador, use uma cópia privada .env.cloud.
APP_ORIGIN=https://SEU-PROJETO.vercel.app
COOKIE_SECURE=true

# Runtime: conexão com pool do Neon. Preserve validação do certificado.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER.neon.tech/educaja?sslmode=verify-full
# Migrações: conexão direta com o MESMO banco/branch, fora do pool.
MIGRATION_DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/educaja?sslmode=verify-full
DB_CONNECTION_TIMEOUT_MS=10000

# Ativar somente após provisionar as credenciais privadas do servidor.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=200
RESEND_API_KEY=
EMAIL_FROM=
